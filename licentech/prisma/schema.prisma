generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  REVIEW
  PAID
  PAID_NO_STOCK
  FAILED
}

enum LicenseStatus {
  AVAILABLE
  SOLD
}

enum ProductDeliveryType {
  LICENSE_KEY
  ACCOUNT_ACTIVATION
  CREDITS
  RENTAL
}

enum RentalUnit {
  HOUR
  MONTH
}

enum DeliveryStatus {
  PENDING
  COMPLETED
}

enum ReviewStatus {
  PENDING
  APPROVED
}

enum TopUpStatus {
  PENDING
  REVIEW
  APPROVED
  REJECTED
}

model User {
  id                 String              @id @default(cuid())
  name               String
  email              String              @unique
  passwordHash       String
  phone              String?             @unique
  phoneVerifiedAt    DateTime?
  role               Role                @default(USER)
  createdAt          DateTime            @default(now())
  walletBalanceCop   Int                 @default(0)
  orders             Order[]
  phoneCodes         PhoneCode[]
  review             CustomerReview?
  walletTransactions WalletTransaction[]
  walletTopUps       WalletTopUp[]
}

model PhoneCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Product {
  id              String               @id @default(cuid())
  slug            String               @unique
  name            String
  vendor          String               @default("")
  version         String               @default("")
  description     String               @default("") @db.Text
  youtubeUrl      String?
  officialUrl     String?
  category        String               @default("Software")
  searchTerms     String               @default("")
  priceCop        Int // pesos enteros (COP no usa decimales)
  deliveryType    ProductDeliveryType  @default(LICENSE_KEY)
  creditAmount    Int?
  deliveryDetails String?              @db.Text
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  orders          Order[]
  orderItems      OrderItem[]
  licenses        License[]
  image           ProductImage?
  gallery         ProductGalleryItem[]
  rentalOptions   RentalOption[]
  coverMediaId    String?
  coverMedia      MediaAsset?          @relation("ProductCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
}

model RentalOption {
  id        String     @id @default(cuid())
  productId String
  quantity  Int
  unit      RentalUnit
  priceCop  Int
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, quantity, unit])
  @@index([productId, active, sortOrder])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  content   Bytes
  mimeType  String
  createdAt DateTime @default(now())
}

model MediaAsset {
  id            String               @id @default(cuid())
  name          String
  altText       String               @default("")
  content       Bytes?
  mimeType      String?
  externalUrl   String?
  createdAt     DateTime             @default(now())
  coverOf       Product[]            @relation("ProductCover")
  galleryItems  ProductGalleryItem[]
  banners       SiteBanner[]
  tutorialItems TutorialMedia[]
}

model ProductGalleryItem {
  id        String     @id @default(cuid())
  productId String
  mediaId   String
  position  Int        @default(0)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([productId, position])
}

model SiteBanner {
  id          String      @id @default(cuid())
  title       String
  description String      @default("") @db.Text
  linkUrl     String?
  mediaId     String?
  media       MediaAsset? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  active      Boolean     @default(false)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([active, sortOrder])
}

model SiteSettings {
  id               String   @id @default("main")
  siteName         String   @default("LicenTech Colombia")
  heroTitle        String   @default("Herramientas de software para desbloqueo y mantenimiento")
  heroDescription  String   @default("") @db.Text
  heroNotice       String   @default("") @db.Text
  supportEmail     String   @default("")
  whatsappNumber   String   @default("")
  telegramUsername String   @default("")
  updatedAt        DateTime @updatedAt
}

model SupportFaq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model Tutorial {
  id         String             @id @default(cuid())
  slug       String             @unique
  title      String
  category   String
  summary    String             @default("") @db.Text
  content    String             @db.Text
  youtubeUrl String?
  vipOnly    Boolean            @default(false)
  published  Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  media      TutorialMedia[]
  downloads  DownloadResource[]

  @@index([published, category])
}

model TutorialMedia {
  id         String     @id @default(cuid())
  tutorialId String
  mediaId    String
  caption    String     @default("")
  position   Int        @default(0)
  tutorial   Tutorial   @relation(fields: [tutorialId], references: [id], onDelete: Cascade)
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([tutorialId, position])
}

model DownloadResource {
  id          String   @id @default(cuid())
  tutorialId  String
  title       String
  description String   @default("")
  url         String
  createdAt   DateTime @default(now())
  tutorial    Tutorial @relation(fields: [tutorialId], references: [id], onDelete: Cascade)

  @@index([tutorialId])
}

model PaymentMethodConfig {
  id           String   @id @default(cuid())
  code         String   @unique
  label        String
  instructions String   @db.Text
  active       Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id                 String              @id @default(cuid())
  reference          String              @unique
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerName          String
  buyerEmail         String
  buyerPhone         String
  activationEmail    String?
  accessTokenHash    String?
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  quantity           Int                 @default(1)
  amountCop          Int
  status             OrderStatus         @default(PENDING)
  deliveryStatus     DeliveryStatus      @default(PENDING)
  deliveredAt        DateTime?
  emailSentAt        DateTime?
  wompiTxId          String?             @unique
  paymentMethod      String?
  payerName          String?
  paidAt             DateTime?
  createdAt          DateTime            @default(now())
  licenses           License[]
  paymentProof       PaymentProof?
  walletTransactions WalletTransaction[]
  items              OrderItem[]

  @@index([userId, createdAt])
  @@index([buyerEmail, createdAt])
  @@index([status, deliveryStatus])
}

model OrderItem {
  id              String      @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  unitPriceCop    Int
  activationEmail String?
  rentalDuration  Int?
  rentalUnit      RentalUnit?
  createdAt       DateTime    @default(now())
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product     @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model CustomerReview {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String       @db.VarChar(1200)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status, createdAt])
}

model WalletTopUp {
  id            String      @id @default(cuid())
  userId        String
  amountCop     Int
  paymentMethod String
  reference     String      @unique
  status        TopUpStatus @default(PENDING)
  proofContent  Bytes?
  proofMimeType String?
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  amountCop   Int
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topUpId     String?  @unique
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([orderId])
}

model PaymentProof {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  content   Bytes
  mimeType  String
  fileName  String
  createdAt DateTime @default(now())
}

model License {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  keyEnc    String // AES-256-GCM
  keyHash   String        @unique // HMAC: evita claves duplicadas sin guardarlas en claro
  status    LicenseStatus @default(AVAILABLE)
  orderId   String?
  order     Order?        @relation(fields: [orderId], references: [id])
  soldAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([productId, status])
}
